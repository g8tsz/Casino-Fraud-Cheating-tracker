# ── Data ──────────────────────────────────────────────
DATA_SOURCE=memory
DATA_DIR=./data
# DB_PATH=./data/tracker.db

# External API sync (write + optional read when DATA_SOURCE=api)
# LIVE_API_BASE_URL=https://your-api.example.com
# LIVE_API_KEY=your-secret-key

# ── Auth / RBAC ───────────────────────────────────────
# Set REQUIRE_AUTH=true in production
REQUIRE_AUTH=false
INGEST_API_KEY=
DASHBOARD_API_KEY=
# Roles via header: X-Role: viewer | triage | admin
# Multi-tenant scope: X-Casino-Id: casino-a

# ── Rate limiting ─────────────────────────────────────
INGEST_RATE_LIMIT_PER_MIN=600
INGEST_MAX_BATCH=500

# ── Detection thresholds (defaults; override in Rules UI) ──
# RTP_MIN_PCT=85
# RTP_MAX_PCT=102
# BAD_REQUEST_RATE_THRESHOLD=0.15
# WIN_RATE_SUSPICIOUS_PCT=65
# RATE_ABUSE_PER_MIN=120
# CHIP_PASSING_THRESHOLD=5000
# TABLE_MAX_BET=10000
# SESSION_MAX_HOURS=12
# ALERT_COOLDOWN_MS=300000

# ── ML anomaly ────────────────────────────────────────
# Z-score threshold in rules UI (ml_anomaly rule)

# ── Webhooks ──────────────────────────────────────────
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Regulatory ────────────────────────────────────────
RETENTION_DAYS=365

# ── CCTV (pit boss) ─────────────────────────────────
# Auto-import on first start if DB has no cameras
# CAMERAS_FILE=./data/cameras.json
# Route snapshot/MJPEG through server proxy (auth, mixed content)
# CCTV_PROXY_ALL=false
